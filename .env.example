# Ego Discord Bot Environment Configuration

# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
BOT_TOKEN=your_discord_bot_token_here

# Application / Client ID (From Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# Database URL
# For local development: sqlite+aiosqlite:///ego_bot.db
# For Render / PostgreSQL cloud: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///ego_bot.db

# Bot Configuration
DEFAULT_PREFIX=!
EMBED_COLOR=0x5865F2
ENVIRONMENT=production
LOG_LEVEL=INFO
